# Report commerce & delivery (set these in Vercel → Project → Environment Variables).
# Until they are set, the on-site checkout/download safely no-op and the site
# falls back to the existing store. Use Stripe TEST keys to trial the flow first.

# Stripe (server-side checkout + webhook verification)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (delivery + lead/custom-request emails); From domain must be verified
RESEND_API_KEY=
REPORTS_FROM="Lodestone Global <reports@lodestoneglobal.com>"
REPORTS_INBOX=inquire@lodestoneglobal.com

# Vercel Blob (private report storage). Auto-added when the Blob store is
# connected to the project; otherwise copy it from the store settings.
BLOB_READ_WRITE_TOKEN=

# Any long random string; used to sign download links.
DOWNLOAD_SIGNING_SECRET=

# Canonical site origin (used in emails and checkout redirects).
NEXT_PUBLIC_SITE_URL=https://www.lodestoneglobal.com
